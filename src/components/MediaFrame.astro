---
interface Props {
  title: string;
  caption: string;
  variant: 'phone' | 'dashboard' | 'system' | 'operations';
  accent?: 'orange' | 'blue' | 'steel';
  compact?: boolean;
}

const { title, caption, variant, accent = 'blue', compact = false } = Astro.props;
---

<figure class:list={['media-frame', `media-frame--${variant}`, `media-frame--${accent}`, { 'media-frame--compact': compact }]}>
  <div class="media-frame__canvas" aria-hidden="true">
    <div class="window-bar">
      <span></span><span></span><span></span>
      <small>sanitized preview</small>
    </div>

    {variant === 'phone' && (
      <div class="phone-scene">
        <div class="phone-shell phone-shell--back">
          <div class="phone-top"></div>
          <div class="tool-grid">
            <i></i><i></i><i></i><i></i>
          </div>
          <div class="sync-line"><span></span></div>
        </div>
        <div class="phone-shell phone-shell--front">
          <div class="phone-top"></div>
          <div class="phone-heading"></div>
          <div class="data-row"><i></i><b></b></div>
          <div class="data-row"><i></i><b></b></div>
          <div class="data-row"><i></i><b></b></div>
          <div class="phone-action"></div>
        </div>
        <div class="status-pill"><span></span> offline ready</div>
      </div>
    )}

    {variant === 'dashboard' && (
      <div class="dashboard-scene">
        <div class="dash-rail"><i></i><i></i><i></i><i></i></div>
        <div class="dash-main">
          <div class="dash-heading"><span></span><i></i></div>
          <div class="bento-grid">
            <div class="bento-card bento-card--wide"><span></span><div class="sparkline"></div></div>
            <div class="bento-card"><span></span><div class="ring"></div></div>
            <div class="bento-card"><span></span><div class="mini-list"><i></i><i></i><i></i></div></div>
            <div class="bento-card bento-card--agent"><span>local agent</span><div class="agent-line"></div></div>
          </div>
        </div>
      </div>
    )}

    {variant === 'system' && (
      <div class="system-scene">
        <div class="system-line system-line--one"></div>
        <div class="system-line system-line--two"></div>
        <div class="system-line system-line--three"></div>
        <div class="system-node system-node--edge"><i></i><span>edge</span></div>
        <div class="system-node system-node--core"><i></i><span>services</span></div>
        <div class="system-node system-node--data"><i></i><span>data</span></div>
        <div class="system-node system-node--observe"><i></i><span>observe</span></div>
      </div>
    )}

    {variant === 'operations' && (
      <div class="operations-scene">
        <div class="ops-grid"></div>
        <div class="ops-chart">
          <i style="--bar: 48%"></i><i style="--bar: 68%"></i><i style="--bar: 56%"></i><i style="--bar: 82%"></i><i style="--bar: 72%"></i><i style="--bar: 91%"></i>
        </div>
        <div class="ops-log"><span>health</span><b>nominal</b><i></i><i></i><i></i></div>
        <div class="ops-badge"><span></span> recovery checked</div>
      </div>
    )}
  </div>
  <figcaption>
    <strong>{title}</strong>
    <span>{caption}</span>
  </figcaption>
</figure>

<style>
  .media-frame {
    --visual-accent: var(--accent-blue);
    background: var(--surface);
    border: 1px solid var(--border);
    margin: 0;
    min-width: 0;
    overflow: hidden;
  }

  .media-frame--orange { --visual-accent: var(--accent-orange); }
  .media-frame--steel { --visual-accent: var(--accent-steel); }

  .media-frame__canvas {
    aspect-ratio: 16 / 10;
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--visual-accent) 9%, transparent), transparent 48%),
      radial-gradient(circle at 75% 20%, color-mix(in srgb, var(--visual-accent) 10%, transparent), transparent 30%),
      var(--ink-deep);
    border-bottom: 1px solid var(--border);
    min-height: 15rem;
    overflow: hidden;
    position: relative;
  }

  .media-frame--compact .media-frame__canvas {
    min-height: 13rem;
  }

  .window-bar {
    align-items: center;
    border-bottom: 1px solid color-mix(in srgb, var(--border) 75%, transparent);
    display: flex;
    gap: 0.35rem;
    height: 2rem;
    padding: 0 0.8rem;
  }

  .window-bar > span {
    background: var(--border-strong);
    border-radius: 50%;
    height: 0.36rem;
    width: 0.36rem;
  }

  .window-bar > span:first-child { background: var(--visual-accent); }

  .window-bar small {
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: 0.48rem;
    letter-spacing: 0.1em;
    margin-left: auto;
    text-transform: uppercase;
  }

  figcaption {
    display: grid;
    gap: 0.35rem;
    padding: 1rem 1.1rem 1.15rem;
  }

  figcaption strong {
    font-size: 0.9rem;
    font-weight: 600;
  }

  figcaption span {
    color: var(--text-muted);
    font-size: 0.78rem;
    line-height: 1.5;
  }

  .phone-scene,
  .dashboard-scene,
  .system-scene,
  .operations-scene {
    bottom: 0;
    left: 0;
    position: absolute;
    right: 0;
    top: 2rem;
  }

  .phone-shell {
    background: var(--surface-raised);
    border: 1px solid color-mix(in srgb, var(--visual-accent) 35%, var(--border));
    border-radius: 1.25rem;
    box-shadow: 0 1.5rem 3rem rgb(0 0 0 / 25%);
    overflow: hidden;
    padding: 1rem;
    position: absolute;
    width: 26%;
  }

  .phone-shell--front {
    bottom: -6%;
    height: 88%;
    left: 42%;
    transform: rotate(4deg);
  }

  .phone-shell--back {
    bottom: -18%;
    height: 82%;
    left: 24%;
    opacity: 0.68;
    transform: rotate(-7deg);
  }

  .phone-top {
    background: var(--border-strong);
    border-radius: 2rem;
    height: 0.3rem;
    margin: 0 auto 1.2rem;
    width: 30%;
  }

  .phone-heading,
  .data-row i,
  .data-row b,
  .tool-grid i,
  .sync-line,
  .phone-action {
    background: var(--border);
    border-radius: 0.25rem;
    display: block;
  }

  .phone-heading { height: 0.5rem; margin-bottom: 1rem; width: 55%; }
  .data-row { align-items: center; display: flex; justify-content: space-between; margin: 0.7rem 0; }
  .data-row i { height: 0.34rem; width: 52%; }
  .data-row b { background: color-mix(in srgb, var(--visual-accent) 35%, var(--border)); height: 1rem; width: 24%; }
  .phone-action { background: var(--visual-accent); height: 1.35rem; margin-top: 1rem; opacity: 0.85; }
  .tool-grid { display: grid; gap: 0.45rem; grid-template-columns: 1fr 1fr; }
  .tool-grid i { aspect-ratio: 1.3; }
  .sync-line { height: 0.3rem; margin-top: 1rem; overflow: hidden; }
  .sync-line span { background: var(--visual-accent); display: block; height: 100%; width: 72%; }

  .status-pill,
  .ops-badge {
    align-items: center;
    backdrop-filter: blur(12px);
    background: rgb(17 21 28 / 82%);
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    bottom: 12%;
    color: var(--text-muted);
    display: flex;
    font-family: var(--font-mono);
    font-size: clamp(0.48rem, 1.3vw, 0.66rem);
    gap: 0.45rem;
    letter-spacing: 0.04em;
    padding: 0.55rem 0.75rem;
    position: absolute;
    right: 8%;
    text-transform: uppercase;
  }

  .status-pill span,
  .ops-badge span {
    background: var(--status-green);
    border-radius: 50%;
    height: 0.4rem;
    width: 0.4rem;
  }

  .dashboard-scene {
    display: grid;
    grid-template-columns: 12% 1fr;
    padding: 7% 10% 0;
  }

  .dash-rail {
    background: color-mix(in srgb, var(--surface-raised) 80%, transparent);
    border: 1px solid var(--border);
    border-radius: 0.6rem 0 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    padding: 0.8rem 0.55rem;
  }

  .dash-rail i {
    aspect-ratio: 1;
    background: var(--border);
    border-radius: 0.22rem;
    display: block;
  }

  .dash-rail i:first-child { background: var(--visual-accent); }

  .dash-main {
    background: color-mix(in srgb, var(--surface) 90%, transparent);
    border: 1px solid var(--border);
    border-left: 0;
    padding: 1rem;
  }

  .dash-heading { align-items: center; display: flex; justify-content: space-between; margin-bottom: 0.65rem; }
  .dash-heading span { background: var(--border-strong); height: 0.4rem; width: 26%; }
  .dash-heading i { background: var(--visual-accent); border-radius: 50%; height: 0.8rem; width: 0.8rem; }
  .bento-grid { display: grid; gap: 0.5rem; grid-template-columns: 1.2fr 0.8fr; }
  .bento-card { background: var(--surface-raised); border: 1px solid var(--border); min-height: 3.1rem; padding: 0.55rem; }
  .bento-card > span { color: var(--text-faint); display: block; font-family: var(--font-mono); font-size: 0.43rem; text-transform: uppercase; }
  .bento-card--wide { grid-column: 1 / -1; }
  .sparkline { border-bottom: 1px solid var(--visual-accent); height: 1.5rem; margin-top: 0.25rem; transform: skewY(-5deg); }
  .ring { border: 0.3rem solid var(--border-strong); border-right-color: var(--visual-accent); border-radius: 50%; height: 1.4rem; margin: 0.25rem auto 0; width: 1.4rem; }
  .mini-list { display: grid; gap: 0.25rem; margin-top: 0.4rem; }
  .mini-list i { background: var(--border-strong); height: 0.22rem; width: 100%; }
  .bento-card--agent { border-color: color-mix(in srgb, var(--visual-accent) 30%, var(--border)); }
  .agent-line { background: linear-gradient(90deg, var(--visual-accent) 58%, var(--border) 58%); height: 0.22rem; margin-top: 0.8rem; }

  .system-scene { margin: 5% 10%; }
  .system-node { align-items: center; display: grid; gap: 0.35rem; justify-items: center; position: absolute; }
  .system-node i { background: var(--surface-raised); border: 1px solid color-mix(in srgb, var(--visual-accent) 45%, var(--border)); border-radius: 0.5rem; box-shadow: 0 0 2rem color-mix(in srgb, var(--visual-accent) 11%, transparent); height: clamp(2.4rem, 7vw, 4rem); width: clamp(2.4rem, 7vw, 4rem); }
  .system-node span { color: var(--text-faint); font-family: var(--font-mono); font-size: clamp(0.45rem, 1.2vw, 0.62rem); text-transform: uppercase; }
  .system-node--edge { left: 4%; top: 35%; }
  .system-node--core { left: 40%; top: 10%; }
  .system-node--data { bottom: 4%; left: 44%; }
  .system-node--observe { right: 4%; top: 35%; }
  .system-line { background: var(--border-strong); height: 1px; left: 15%; position: absolute; top: 47%; transform-origin: left center; width: 37%; }
  .system-line::after { background: var(--visual-accent); border-radius: 50%; content: ''; height: 0.35rem; position: absolute; right: 0; top: -0.16rem; width: 0.35rem; }
  .system-line--one { transform: rotate(-19deg); }
  .system-line--two { transform: rotate(19deg); }
  .system-line--three { left: 55%; transform: rotate(0deg); width: 30%; }

  .operations-scene { padding: 8% 9%; }
  .ops-grid { background-image: linear-gradient(var(--border) 1px, transparent 1px), linear-gradient(90deg, var(--border) 1px, transparent 1px); background-size: 1.5rem 1.5rem; inset: 0; opacity: 0.22; position: absolute; }
  .ops-chart { align-items: end; bottom: 14%; display: flex; gap: 3%; height: 58%; left: 9%; position: absolute; width: 50%; }
  .ops-chart i { background: linear-gradient(180deg, var(--visual-accent), color-mix(in srgb, var(--visual-accent) 18%, transparent)); border-radius: 0.2rem 0.2rem 0 0; height: var(--bar); opacity: 0.72; width: 12%; }
  .ops-log { background: rgb(17 21 28 / 86%); border: 1px solid var(--border-strong); display: grid; gap: 0.55rem; padding: 0.9rem; position: absolute; right: 8%; top: 18%; width: 28%; }
  .ops-log span { color: var(--text-faint); font-family: var(--font-mono); font-size: 0.5rem; text-transform: uppercase; }
  .ops-log b { color: var(--status-green); font-family: var(--font-mono); font-size: 0.7rem; font-weight: 500; }
  .ops-log i { background: var(--border-strong); display: block; height: 0.25rem; }
  .ops-log i:nth-last-child(1) { width: 64%; }
  .ops-log i:nth-last-child(2) { width: 82%; }

  @media (max-width: 34rem) {
    .media-frame__canvas { aspect-ratio: 4 / 3; min-height: 13rem; }
    .phone-shell { width: 34%; }
    .phone-shell--back { left: 14%; }
    .phone-shell--front { left: 42%; }
    .dashboard-scene { padding: 9% 5% 0; }
    .ops-log { width: 35%; }
  }
</style>
