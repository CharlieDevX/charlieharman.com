---
interface Props {
  tags: string[];
  label?: string;
}

const { tags, label = 'Technologies' } = Astro.props;
---

<ul class="tag-list" aria-label={label}>
  {tags.map((tag) => <li>{tag}</li>)}
</ul>

<style>
  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tag-list li {
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    line-height: 1;
    padding: 0.55rem 0.7rem;
  }
</style>
