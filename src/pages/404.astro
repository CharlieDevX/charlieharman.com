---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found"
  description="The requested page could not be found on Charlie Harman's portfolio."
>
  <section class="not-found">
    <div class="not-found__code" aria-hidden="true">404</div>
    <div class="not-found__content">
      <p class="eyebrow"><span aria-hidden="true">//</span> Route unavailable</p>
      <h1>This path doesn’t<br />lead anywhere.</h1>
      <p>The page may have moved, or it may never have existed. The working systems are still this way.</p>
      <div class="not-found__actions">
        <a class="button" href="/">Return home <span aria-hidden="true">←</span></a>
        <a class="text-link" href="/projects/">Browse projects <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found { align-items: center; display: grid; gap: clamp(2rem, 8vw, 8rem); grid-template-columns: 0.65fr 1fr; min-height: min(48rem, calc(100vh - 5rem)); padding: clamp(4rem, 10vw, 8rem) 0; }
  .not-found__code { color: transparent; font-size: clamp(8rem, 24vw, 22rem); font-weight: 600; letter-spacing: -0.1em; line-height: 0.7; -webkit-text-stroke: 1px var(--border-strong); writing-mode: vertical-rl; }
  .not-found h1 { font-size: clamp(3.5rem, 8vw, 7rem); letter-spacing: -0.068em; line-height: 0.9; margin: 1.5rem 0 2rem; }
  .not-found__content > p:not(.eyebrow) { color: var(--text-muted); font-family: var(--font-serif); font-size: 1.1rem; line-height: 1.6; max-width: 34rem; }
  .not-found__actions { align-items: center; display: flex; gap: 1.5rem; margin-top: 2.5rem; }

  @media (max-width: 42rem) {
    .not-found { grid-template-columns: 1fr; }
    .not-found__code { font-size: 8rem; writing-mode: initial; }
    .not-found__actions { align-items: start; flex-direction: column; }
  }
</style>
