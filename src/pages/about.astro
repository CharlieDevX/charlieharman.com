---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import TagList from '../components/TagList.astro';

const interests = [
  'Product engineering',
  'Distributed data',
  'Self-hosted systems',
  'Developer tooling',
  'Resilient infrastructure',
  'Local-first software',
];
---

<BaseLayout
  title="About"
  description="About Charlie Harman, a fourth-year Computer Science Engineering student at Michigan State University who builds practical software and infrastructure systems."
>
  <header class="page-intro about-intro">
    <div>
      <p class="eyebrow"><span aria-hidden="true">//</span> About · Engineer in progress</p>
      <h1>Curious about<br />the whole system.</h1>
    </div>
    <div class="page-intro__aside">
      <p>I’m Charlie, a fourth-year Computer Science Engineering student at Michigan State University.</p>
      <p>I care about software that is useful on an ordinary Tuesday—not just impressive in a launch video.</p>
    </div>
  </header>

  <section class="section about-story" aria-labelledby="story-heading">
    <div class="about-story__label">
      <p class="eyebrow"><span aria-hidden="true">//</span> The throughline</p>
    </div>
    <div>
      <h2 id="story-heading">From an interface<br />to an operating reality.</h2>
      <div class="about-story__copy">
        <p>
          My best learning happens when a system has real users, real data, and a reason to stay healthy.
          That has pulled me beyond isolated features into access control, synchronization, deployment,
          observability, and recovery.
        </p>
        <p>
          The projects here span store operations, personal software, and private infrastructure.
          They look different on the surface, but each is an exercise in turning ambiguity into a system
          someone can understand and depend on.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--bordered education" aria-labelledby="education-heading">
    <SectionHeading eyebrow="Education" heading="Michigan State University." />
    <div class="education__grid">
      <div>
        <h2 id="education-heading" class="sr-only">Education at Michigan State University</h2>
        <p class="education__degree">B.S. Computer Science Engineering</p>
        <p class="education__status">Fourth-year student · East Lansing, Michigan</p>
      </div>
      <p>
        Coursework provides the theory; building and operating systems supplies the feedback loop.
        I’m especially interested in the boundary between application engineering and the infrastructure
        that makes an application trustworthy.
      </p>
    </div>
  </section>

  <section class="section working-style" aria-labelledby="style-heading">
    <SectionHeading eyebrow="Working style" heading="Direct, deliberate, iterative." />
    <h2 class="sr-only" id="style-heading">How Charlie works</h2>
    <p class="working-style__lead">
      Anyone can be curious about a problem. The work is asking it the <em>right</em> questions.
    </p>
    <div class="principles">
      <article>
        <span>01</span>
        <h3>Make the state visible.</h3>
        <p>Good interfaces and good operations both help people understand what is happening, what changed, and what to do next.</p>
      </article>
      <article>
        <span>02</span>
        <h3>Prefer explicit boundaries.</h3>
        <p>Clear ownership, typed contracts, and narrow permissions make systems easier to change and harder to misuse.</p>
      </article>
      <article>
        <span>03</span>
        <h3>Learn from production.</h3>
        <p>Real use exposes the difference between a clever implementation and a durable product. I want that feedback early.</p>
      </article>
    </div>
  </section>

  <section class="section section--bordered interests" aria-labelledby="interests-heading">
    <div class="interests__copy">
      <p class="eyebrow"><span aria-hidden="true">//</span> Current interests</p>
      <h2 id="interests-heading">Problems I keep returning to.</h2>
      <p>Useful abstractions, local ownership of data, calm operational surfaces, and systems that can explain their own health.</p>
    </div>
    <TagList tags={interests} label="Current engineering interests" />
  </section>

  <section class="cta-band" aria-labelledby="about-contact-cta">
    <div>
      <p class="eyebrow"><span aria-hidden="true">//</span> Say hello</p>
      <h2 id="about-contact-cta">Have a hard, useful problem?</h2>
    </div>
    <a class="button" href="/contact/">Contact Charlie <span aria-hidden="true">→</span></a>
  </section>
</BaseLayout>

<style>
  .about-intro h1 { max-width: 12ch; }
  .about-story { display: grid; gap: clamp(2rem, 8vw, 8rem); grid-template-columns: minmax(10rem, 0.3fr) 1fr; }
  .about-story__label .eyebrow { margin: 0; }
  .about-story h2 { font-size: clamp(3rem, 8vw, 7rem); letter-spacing: -0.068em; line-height: 0.9; margin: 0 0 clamp(2.5rem, 6vw, 5rem); }
  .about-story__copy { display: grid; gap: clamp(1.5rem, 5vw, 4rem); grid-template-columns: 1fr 1fr; }
  .about-story__copy p { color: var(--text-muted); font-family: var(--font-serif); font-size: 1.1rem; line-height: 1.7; margin: 0; }
  .education__grid { display: grid; gap: clamp(2rem, 8vw, 8rem); grid-template-columns: 1fr 1fr; }
  .education__degree { font-size: clamp(1.7rem, 4vw, 3.2rem); letter-spacing: -0.04em; margin: 0; }
  .education__status { color: var(--accent-blue); font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.06em; margin: 1rem 0 0; text-transform: uppercase; }
  .education__grid > p { color: var(--text-muted); font-family: var(--font-serif); font-size: 1.15rem; line-height: 1.65; margin: 0; }
  .working-style__lead { color: var(--text-muted); font-family: var(--font-serif); font-size: clamp(1.15rem, 2.4vw, 1.65rem); line-height: 1.5; margin: 0 0 clamp(2rem, 5vw, 3.5rem); max-width: 46ch; }
  .working-style__lead em { color: var(--accent-blue); font-style: italic; }
  .principles { display: grid; gap: 1px; grid-template-columns: repeat(3, 1fr); background: var(--border); border: 1px solid var(--border); }
  .principles article { background: var(--ink); min-height: 22rem; padding: clamp(1.25rem, 3vw, 2.5rem); }
  .principles article > span { color: var(--accent-orange); font-family: var(--font-mono); font-size: 0.68rem; }
  .principles h3 { font-size: clamp(1.5rem, 3vw, 2.35rem); letter-spacing: -0.045em; line-height: 1.05; margin: 7rem 0 1rem; }
  .principles p { color: var(--text-muted); font-size: 0.86rem; line-height: 1.6; margin: 0; }
  .interests { align-items: end; display: grid; gap: clamp(2rem, 8vw, 8rem); grid-template-columns: minmax(18rem, 0.65fr) 1fr; }
  .interests h2 { font-size: clamp(2.4rem, 5vw, 4.75rem); letter-spacing: -0.06em; line-height: 0.95; margin: 1rem 0 1.5rem; }
  .interests__copy > p:last-child { color: var(--text-muted); font-family: var(--font-serif); line-height: 1.6; margin: 0; }

  @media (max-width: 52rem) {
    .about-story,
    .education__grid,
    .interests { grid-template-columns: 1fr; }
    .principles { grid-template-columns: 1fr; }
    .principles article { min-height: 15rem; }
    .principles h3 { margin-top: 4rem; }
  }

  @media (max-width: 38rem) {
    .about-story__copy { grid-template-columns: 1fr; }
  }
</style>
